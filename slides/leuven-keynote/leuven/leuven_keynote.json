    {
      "id": "three-applications",
      "hidden": false,
      "layout": "auto",
      "background": null,
      "header": "",
      "aside": "",
      "speaker": "",
      "print": "",
      "steps": 3,
      "blocks": [
        {
          "type": "title",
          "content": "3 places we're needed now",
          "step": 0
        },
        {
          "type": "list",
          "ordered": true,
          "start": 1,
          "progressive": true,
          "size": "normal",
          "items": [
            {
              "content": "**Agents, swarms, agent societies.** The institutions we know can channel what they do.",
              "step": 0,
              "number": 1
            },
            {
              "content": "**Safety and access.** Every question ends in politics and international relations.",
              "step": 1,
              "number": 2
            },
            {
              "content": "**Government by AI.** Budgets will force it. Someone has to manage it.",
              "step": 2,
              "number": 3
            }
          ],
          "step": 0
        },
        {
          "type": "text",
          "size": "normal",
          "content": "**These are not software engineering problems.**",
          "step": 3,
          "align": "center"
        }
      ]
    },
