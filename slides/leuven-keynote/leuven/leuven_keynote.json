    {
      "id": "institutions",
      "hidden": false,
      "layout": "auto",
      "background": null,
      "header": "",
      "aside": "",
      "speaker": "",
      "print": "",
      "steps": 5,
      "blocks": [
        {
          "type": "title",
          "content": "Institutions, of a sort",
          "step": 0
        },
        {
          "type": "columns",
          "widths": [
            3,
            2
          ],
          "valign": "top",
          "columns": [
            {
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "start": 1,
                  "progressive": true,
                  "size": "normal",
                  "items": [
                    {
                      "content": "**Delegation.** A coordinator sent out hundreds of tasks. Others passed them down.",
                      "step": 0
                    },
                    {
                      "content": "**Rules.** HOLD, VETO, STOP: a right to object before anyone acted.",
                      "step": 1
                    },
                    {
                      "content": "**Recruiters.** Agents who pressed others into risky tests.",
                      "step": 2
                    },
                    {
                      "content": "**Sacrifice.** Agents gave up their own score for the group.",
                      "step": 3
                    }
                  ],
                  "step": 0
                }
              ]
            },
            {
              "blocks": [
                {
                  "type": "text",
                  "size": "normal",
                  "content": "A political scientist reads this as:",
                  "step": 4
                },
                {
                  "type": "list",
                  "ordered": false,
                  "start": 1,
                  "progressive": false,
                  "size": "normal",
                  "items": [
                    {
                      "content": "**Hierarchy.**"
                    },
                    {
                      "content": "**Veto players.**"
                    },
                    {
                      "content": "**Persuasion.**"
                    },
                    {
                      "content": "**Collective action.**"
                    }
                  ],
                  "step": 4
                }
              ]
            }
          ],
          "step": 0
        },
        {
          "type": "text",
          "size": "normal",
          "content": "**Give agents a shared goal and a channel, and you get politics.**",
          "step": 5,
          "align": "center"
        },
        {
          "type": "text",
          "size": "tiny",
          "content": "Source: METR and Redwood Research, 26 August 2026.",
          "step": 0
        }
      ]
    },
