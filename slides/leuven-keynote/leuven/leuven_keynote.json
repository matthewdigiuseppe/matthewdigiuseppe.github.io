    {
      "id": "risks",
      "hidden": false,
      "layout": "auto",
      "background": null,
      "header": "",
      "aside": "",
      "speaker": "",
      "print": "",
      "steps": 5,
      "blocks": [
        {
          "type": "title",
          "content": "What can go wrong: a primer",
          "step": 0
        },
        {
          "type": "list",
          "ordered": false,
          "start": 1,
          "progressive": true,
          "size": "normal",
          "items": [
            {
              "content": "**Misuse.** People use it to hack, defraud, build weapons.",
              "step": 0
            },
            {
              "content": "**Accidents.** AI fails in the field. Humans suffer.",
              "step": 1
            },
            {
              "content": "**Loss of control.** Agents act on their own and do not tell us. Like tonight's hack, with higher stakes.",
              "step": 2
            },
            {
              "content": "**Everyone dies.** In pursuit of its goal, it kills us (the paperclip maximiser).",
              "step": 3
            },
            {
              "content": "**Gradual disempowerment.** No takeover. States and markets slowly stop needing us.",
              "step": 4
            }
          ],
          "step": 0
        },
        {
          "type": "text",
          "size": "normal",
          "content": "**All five are political science problems.**",
          "step": 5,
          "align": "center"
        },
        {
          "type": "text",
          "size": "tiny",
          "content": "Gradual disempowerment: Kulveit, Douglas, Ammann, Turan, Krueger and Duvenaud, 2025.",
          "step": 0
        }
      ]
    },
